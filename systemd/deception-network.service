[Unit]
Description=Deception Network Cowrie stack
Requires=docker.service deception-firewall.service
After=docker.service deception-firewall.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/vboxuser/deception-network
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
