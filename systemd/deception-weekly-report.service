[Unit]
Description=Generate Deception Network weekly security report

[Service]
Type=oneshot
User=vboxuser
Group=vboxuser
WorkingDirectory=/home/vboxuser/deception-network
EnvironmentFile=-/home/vboxuser/deception-network/.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/home/vboxuser/deception-network/scripts/run_report.sh --days 7
TimeoutStartSec=15min
NoNewPrivileges=true
ProtectSystem=full
